#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Show the Omarchy update stage in a terminal

# The frames below come from the ISO install animation. Keep all rendering
# before the corresponding update command, so pacman and gum retain the TTY.
stage=${1:-0}
label=${2:-Updating Omarchy}
[[ $stage =~ ^[0-9]+$ ]] || exit 2
(( stage <= 10 )) || exit 2

if [[ ! -t 1 || ${TERM:-dumb} == "dumb" ]]; then
  exit 0
fi

size=$(stty size 2>/dev/null) || exit 0
rows=${size%% *}
cols=${size#* }
if (( rows < 20 || cols < 36 )); then
  printf '\n%s\n' "$label"
  exit 0
fi

frame_start=$(($(grep -n '^__FRAMES__$' "$0" | cut -d: -f1) + 1))
offset=$(((cols - 32) / 2))
base=$((stage * 10 + 1))

# Redraw three nearby frames in place. The last frame remains visible while
# the real command writes its unfiltered output below it. It is a stage marker,
# not a progress percentage or a separate process writing over pacman output.
for delta in -2 -1 0; do
  index=$((base + delta))
  (( index < 1 )) && index=1
  line=$((frame_start + index - 1))
  frame=$(sed -n "${line}p" "$0")
  [[ -n $frame ]] || exit 0
  if (( delta > -2 )); then
    printf '\033[16A'
  fi
  while IFS= read -r row; do
    printf '%*s%s\n' "$offset" '' "$row"
  done < <(printf '%s' "$frame" | base64 -d | gzip -dc)
  if (( delta < 0 )); then
    sleep 0.09
  fi
done
printf '\n\033[1m%s\033[0m\n' "$label"
exit 0
__FRAMES__
