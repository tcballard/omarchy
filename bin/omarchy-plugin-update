#!/bin/bash

# omarchy:summary=Update installed git-managed plugins
# omarchy:group=plugin
# omarchy:args=[id] [--yes]

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
UPDATED_ANY=0

fail() {
  echo "omarchy-plugin-update: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

update_one() {
  local id="$1"
  local dir="$PLUGINS_DIR/$id"
  [[ ! -L $dir ]] || { echo "Skipped $id: linked source is externally managed."; return 0; }
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugin-workbench"
  if [[ -e $state/marketplace/receipts/$id.json || -L $state/marketplace/receipts/$id.json || -e $state/deployments/$id.json ]]; then
    echo "Skipped $id: update through Plugin Workbench."
    return 0
  fi
  local current reviewed stage
  current=$(git -C "$dir" rev-parse HEAD)
  [[ -z $(git -C "$dir" status --porcelain --untracked-files=normal) ]] || {
    echo "omarchy-plugin-update: '$id' has local changes" >&2
    return 1
  }

  if ! git -C "$dir" fetch --quiet origin HEAD; then
    echo "omarchy-plugin-update: fetch failed for '$id'" >&2
    return 1
  fi

  if [[ $(git -C "$dir" rev-parse HEAD) == $(git -C "$dir" rev-parse FETCH_HEAD) ]]; then
    echo "$id is up to date."
    return 0
  fi

  if (( ! ASSUME_YES )); then
    echo "Changes for $id:"
    if omarchy-cmd-present delta; then
      git -C "$dir" diff HEAD FETCH_HEAD | delta --paging=never
    else
      git -C "$dir" diff HEAD FETCH_HEAD
    fi
    echo
    confirm "Update $id?" || {
      echo "Skipped $id."
      return 0
    }
  fi

  reviewed=$(git -C "$dir" rev-parse FETCH_HEAD)
  stage=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-plugin-update.XXXXXXXX")
  if ! git clone --quiet --no-hardlinks --no-checkout -- "$dir" "$stage" ||
    ! git -C "$stage" checkout --quiet --detach "$reviewed" ||
    ! omarchy-plugin-validate "$stage"; then
    rm -rf -- "$stage"
    echo "omarchy-plugin-update: '$id' failed staged validation; installed files unchanged" >&2
    return 1
  fi
  rm -rf -- "$stage"
  if [[ -L $dir || $(git -C "$dir" rev-parse HEAD) != "$current" || -n $(git -C "$dir" status --porcelain --untracked-files=normal) ]]; then
    echo "omarchy-plugin-update: '$id' changed during validation" >&2
    return 1
  fi
  if ! git -C "$dir" merge --ff-only "$reviewed" >/dev/null 2>&1; then
    echo "omarchy-plugin-update: cannot fast-forward '$id'; you have local changes in $dir" >&2
    return 1
  fi

  if ! omarchy-plugin-validate "$dir"; then
    if ! git -C "$dir" reset --hard "$current" >/dev/null; then
      echo "omarchy-plugin-update: validation and rollback failed for '$id'; inspect $dir" >&2
      return 1
    fi
    echo "omarchy-plugin-update: update of '$id' failed validation; rolled back" >&2
    return 1
  fi

  echo "Updated $id."
  UPDATED_ANY=1
}

id=""

while (( $# > 0 )); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin update [id] [--yes]"
    exit 0
    ;;
  -*)
    fail "unknown update option: $1"
    ;;
  *)
    [[ -z $id ]] || fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

[[ -d $PLUGINS_DIR ]] || fail "no plugins installed"

targets=()
if [[ -n $id ]]; then
  valid_plugin_id "$id" || fail "invalid plugin id '$id'"
  [[ -d $PLUGINS_DIR/$id ]] || fail "plugin '$id' is not installed"
  [[ -d $PLUGINS_DIR/$id/.git ]] ||
    fail "plugin '$id' is not a git checkout, so there is nothing to pull from"
  targets=("$id")
else
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir/.git ]] || continue
    targets+=("$(basename "$dir")")
  done
  if (( ${#targets[@]} == 0 )); then
    echo "No git-managed plugins installed."
    exit 0
  fi
fi

rc=0
for id in "${targets[@]}"; do
  update_one "$id" || rc=1
done

if (( UPDATED_ANY )); then
  omarchy-shell shell rescanPlugins >/dev/null
fi
exit $rc
